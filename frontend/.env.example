# Local dev only — talks to the backend directly (no rewrite running here).
# In production (Vercel), set this to "/api" (relative) instead: vercel.json
# rewrites /api/* to the Cloud Run backend server-side, so the browser only
# ever talks to this same site, and the session cookie can stay same-site.
# See backend/README.md — "Proxy (Vercel rewrite)".
VITE_API_BASE_URL=http://localhost:3001/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
