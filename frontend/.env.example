# Local dev only — talks to the backend directly (no rewrite running here).
# In production use /api (relative). Caddy proxies it in the VPS setup;
# frontend/vercel.json rewrites it to Cloud Run in the Vercel setup.
# Both keep browser API traffic same-origin. See ../README.md.
# VITE_ variables are public build inputs; never put private tokens here.
VITE_API_BASE_URL=http://localhost:3001/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
