# Used by docker-compose.yml, for a self-hosted Postgres + backend stack
# (VPS deploy). Copy to .env in this same directory and fill in real values —
# .env is git-ignored, never commit it.
#
# This is separate from backend/.env / backend/.env.example, which are for
# running the backend directly with `npm run dev` (no Docker) and, for now,
# still point at Supabase/Cloud Run — see backend/README.md.

# Password for the `bescaledhub` Postgres user (the `db` service). Pick a
# strong one — this is the database's actual credential, not a placeholder
# only used locally.
POSTGRES_PASSWORD=

# Google OAuth client id (ID-token flow) — same value as GOOGLE_CLIENT_ID in
# backend/.env.example. GOOGLE_CLIENT_SECRET is not listed here: the backend
# doesn't read it (no authorization-code exchange), so docker-compose.yml
# doesn't pass it to the app container either.
GOOGLE_CLIENT_ID=

# Long random string used to sign session JWTs — same value/purpose as
# JWT_SECRET in backend/.env.example.
JWT_SECRET=

# The frontend's origin, for CORS (e.g. https://bescaled-hub.vercel.app).
FRONTEND_ORIGIN=

# Google accounts allowed to log in as admins, ";"-separated.
ADMIN_EMAILS=

# Public hostname Caddy serves and gets an HTTPS cert for (see Caddyfile) —
# currently the one the VPS host (zone.ee) provided. Change only this value
# when the university's official domain is ready; nothing else references
# the hostname directly.
SITE_DOMAIN=uvn-76-252.tll01.zonevs.eu
