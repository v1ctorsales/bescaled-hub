# Used by docker-compose.yml, for a self-hosted Postgres + backend stack
# (VPS deploy). Copy to .env in this same directory and fill in real values —
# .env is git-ignored, never commit it.
#
# This is separate from backend/.env / backend/.env.example, which are for
# running the backend directly with `npm run dev` (no Docker).
# See backend/README.md for connection and seed behavior.

# Password for the `bescaledhub` Postgres user (the `db` service). Pick a
# strong URL-safe one — Compose inserts it into DATABASE_URL. Changing this
# value does not rotate the password in an already-initialized database.
POSTGRES_PASSWORD=

# Google OAuth client id (ID-token flow) — same value as GOOGLE_CLIENT_ID in
# backend/.env.example. Used twice: read by the backend (app service) at
# runtime, and also passed as a build arg (VITE_GOOGLE_CLIENT_ID) to the
# frontend-build service — it's the one Google client id for both sides, not
# two different values, so there's no separate frontend variable for it.
# GOOGLE_CLIENT_SECRET is not listed here: the backend doesn't read it (no
# authorization-code exchange), so docker-compose.yml doesn't pass it to the
# app container either.
GOOGLE_CLIENT_ID=

# Long random string used to sign session JWTs — same value/purpose as
# JWT_SECRET in backend/.env.example.
JWT_SECRET=

# The frontend's origin, for CORS (normally https://bescaled-batches.tlu.ee).
FRONTEND_ORIGIN=

# Google accounts added as admins during seeding, ";"-separated.
# Removing an email here does not remove the existing admin database row.
ADMIN_EMAILS=

# Optional Slack sandbox workspace connection. The user token is passed only
# to the backend container. Channels are fetched from Slack at runtime.
SLACK_USER_TOKEN=

# Public hostname of the backend-only Caddy site (see Caddyfile) — the one
# the VPS host (zone.ee) provided. The university's official domain
# (bescaled-batches.tlu.ee, serving the frontend + proxying /api/*) has
# since arrived and is a second, separate Caddyfile block — it's hardcoded
# there rather than driven by a variable like this one, since (unlike this
# hostname) it isn't expected to change again.
SITE_DOMAIN=uvn-76-252.tll01.zonevs.eu
