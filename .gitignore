# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables (per-package .env.example files stay tracked)
.env

# Cloud Run deploy env vars (--env-vars-file — see backend/README.md). Holds
# non-secret config, but also admin emails we don't want versioned; real
# secrets (JWT_SECRET, GOOGLE_CLIENT_SECRET) come from Secret Manager instead
# and never go in this file.
backend/env-vars.yaml

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backend SQLite database (contains real data — never commit)
backend/prisma/*.db
backend/prisma/*.db-journal

backend/prisma/*.db-wal
backend/prisma/*.db-shm
