# Direct local backend development: copy to backend/.env and replace values.
# Docker Compose instead reads the repository-root .env; see ../.env.example.
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# One PostgreSQL URL for both Prisma Client and Prisma Migrate.
# Use a development database, with a connection supporting migrations.
# The schema does not read DIRECT_URL. See README.md for managed DB notes.
DATABASE_URL="postgresql://bescaledhub:replace-with-url-safe-password@localhost:5432/bescaledhub"

# Same public Google web client ID as frontend VITE_GOOGLE_CLIENT_ID.
# ID-token flow: GOOGLE_CLIENT_SECRET is not used.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Replace with a long random private string before starting.
JWT_SECRET=replace-with-a-long-random-secret

# Semicolon-separated Google emails. Seeding adds these to AdminEmail;
# removing a value here does not revoke an existing database admin.
ADMIN_EMAILS=admin1@example.com;admin2@example.com

# Optional shared Slack user OAuth token. Keep private; never use VITE_.
# Leave blank to run without Slack. See README.md for scopes/membership.
SLACK_USER_TOKEN=
