PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Postgres, hosted on Supabase. Two different connection strings — see
# "Database" in backend/README.md for why:
# - DATABASE_URL: pooled (Supavisor transaction mode, port 6543) — used by the
#   running app. Needs `?pgbouncer=true` so Prisma doesn't use prepared
#   statements, which the transaction pooler doesn't support.
# - DIRECT_URL: only for Prisma Migrate. Supabase's direct host
#   (db.<project-ref>.supabase.co:5432) is IPv6-only; if your network can't
#   reach it (common on local dev machines/CI), use the Session pooler
#   instead — same pooler host as DATABASE_URL, port 5432, no pgbouncer flag.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres"

# Google OAuth (ID-token flow — only the client id is needed by the backend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Long random string used to sign session JWTs, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me

# Google accounts allowed to log in as admins (prisma/seed.js), ";"-separated.
ADMIN_EMAILS=admin1@example.com;admin2@example.com
