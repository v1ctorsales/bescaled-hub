PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# SQLite file, path relative to prisma/schema.prisma
DATABASE_URL="file:./data.db"

# Google OAuth (ID-token flow — only the client id is needed by the backend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Long random string used to sign session JWTs, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me

# Google accounts allowed to log in as admins (prisma/seed.js), ";"-separated.
ADMIN_EMAILS=admin1@example.com;admin2@example.com
